+    async def ha_keepalive_loop(self) -> None:
+        """Hält den Sensor in HA am Leben.
+
+        HA vergisst per API gesetzte Zustände bei jedem Neustart. Ohne diese Schleife
+        fehlte der Sensor danach, bis das nächste Video oder die nächste Werbung kam.
+        Prüft jede Minute und legt ihn mit dem letzten Stand neu an, wenn er fehlt.
+        """
+        token = os.environ.get("SUPERVISOR_TOKEN")
+        if not token:
+            return
+        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
+        while True:
+            try:
+                if getattr(self, "session", None) is not None:
+                    async with self.session.get(
+                        f"{HA_API}/states/{HA_ENTITY}", headers=headers
+                    ) as resp:
+                        missing = resp.status == 404
+                        await resp.read()
+                    if missing:
+                        await self._ha_post_state(headers)
+                        if self.logger:
+                            self.logger.info("HA: Sensor fehlte (HA-Neustart?), neu angelegt")
+            except Exception as e:  # HA startet gerade neu o. ä.
+                if self.logger:
+                    self.logger.debug(f"HA: Sensor-Prüfung fehlgeschlagen: {e}")
+            await asyncio.sleep(60)
 
