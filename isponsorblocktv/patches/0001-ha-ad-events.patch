 from typing import Any, List
 
@@ -71,6 +72,84 @@ class YtLoungeApi(pyytlounge.YtLoungeApi):
             self.skip_ads = config.skip_ads
             self.auto_play = config.auto_play
         self._command_mutex = asyncio.Lock()
+        # --- Home Assistant: Werbe-Status melden (Fork) ---
+        self._ha_ad_active = None
+        self._ha_device_name = getattr(config, "join_name", None) or "iSponsorBlockTV"
+
+    async def _ha_report_ad(
+        self, active: bool, skippable: bool = False, source: str = "", raw: dict = None
+    ) -> None:
+        """Meldet Werbe-Start/-Ende an Home Assistant (Event + binary_sensor).
+
+        Nur aktiv, wenn das Add-on Zugriff auf die HA-API hat (SUPERVISOR_TOKEN).
+        Meldet nur Wechsel, damit HA nicht mit Events geflutet wird.
+        """
+        token = os.environ.get("SUPERVISOR_TOKEN")
+        if not token or self.session is None:
+            return
+        if raw is not None and self.logger:
+            # Fork: komplette YouTube-Meldung loggen, um Felder (Dauer, Slots) zu sehen
+            self.logger.info(f"HA: {source} {json.dumps(raw, ensure_ascii=False)}")
+        extra = {}
+        if raw:
+            for key in ("duration", "adVideoId", "adTitle", "isBumper", "currentTime",
+                        "adState", "remoteSlotsData", "adSystem"):
+                if key in raw:
+                    extra[key] = raw[key]
+            try:
+                slots = json.loads(raw.get("remoteSlotsData") or "{}")
+                if "currentSlot" in slots:
+                    extra["werbung_nr"] = int(slots["currentSlot"])
+                if "totalSlots" in slots:
+                    extra["werbungen_gesamt"] = int(slots["totalSlots"])
+            except Exception:
+                pass
+            if "duration" in raw:
+                try:
+                    extra["dauer"] = float(raw["duration"])
+                except (TypeError, ValueError):
+                    pass
+        self._ha_extra = {**getattr(self, "_ha_extra", {}), **extra} if active else {}
+        if self._ha_ad_active == active and not (active and (skippable or extra)):
+            return
+        self._ha_ad_active = active
+        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
+        screen = getattr(self, "screen_name", None) or ""
+        payload = {
+            "active": active,
+            "skippable": skippable,
+            "source": source,
+            "screen_name": screen,
+            "video_id": getattr(self._playback_state, "videoId", ""),
+        }
+        base = "http://supervisor/core/api"
+        try:
+            async with self.session.post(
+                f"{base}/events/isponsorblocktv_ad",
+                json={**payload, **getattr(self, "_ha_extra", {})},
+                headers=headers
+            ) as resp:
+                await resp.read()
+            async with self.session.post(
+                f"{base}/states/binary_sensor.isponsorblocktv_werbung",
+                json={
+                    "state": "on" if active else "off",
+                    "attributes": {
+                        "friendly_name": "YouTube-Werbung (iSponsorBlockTV)",
+                        "device_class": "running",
+                        "icon": "mdi:advertisements" if active else "mdi:advertisements-off",
+                        **payload,
+                        **getattr(self, "_ha_extra", {}),
+                    },
+                },
+                headers=headers,
+            ) as resp:
+                await resp.read()
+            if self.logger:
+                self.logger.info(f"HA: Werbung {'an' if active else 'aus'} ({source})")
+        except Exception as e:  # HA nicht erreichbar darf nie das Skippen stören
+            if self.logger:
+                self.logger.warning(f"HA: Meldung fehlgeschlagen: {e}")
 
