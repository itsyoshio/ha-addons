+def _pb_decode(buf: bytes, depth: int = 0, max_depth: int = 8):
+    """Minimaler Protobuf-Decoder (ohne Schema) für das playerOverlay-Feld.
+
+    Liefert eine Liste (feldnummer, wert). Längen-Felder werden, wenn möglich,
+    rekursiv dekodiert, sonst als Text (UTF-8) oder Hex zurückgegeben.
+    """
+    out, i, n = [], 0, len(buf)
+
+    def varint(j):
+        shift = val = 0
+        while j < n:
+            b = buf[j]
+            j += 1
+            val |= (b & 0x7F) << shift
+            if not b & 0x80:
+                return val, j
+            shift += 7
+            if shift > 63:
+                break
+        raise ValueError("varint")
+
+    try:
+        while i < n:
+            key, i = varint(i)
+            field, wtype = key >> 3, key & 7
+            if field == 0:
+                raise ValueError("field0")
+            if wtype == 0:
+                v, i = varint(i)
+                out.append((field, v))
+            elif wtype == 1:
+                out.append((field, buf[i:i + 8].hex()))
+                i += 8
+            elif wtype == 5:
+                out.append((field, buf[i:i + 4].hex()))
+                i += 4
+            elif wtype == 2:
+                ln, i = varint(i)
+                chunk = buf[i:i + ln]
+                i += ln
+                if len(chunk) != ln:
+                    raise ValueError("len")
+                sub = None
+                if depth < max_depth and ln > 1:
+                    try:
+                        sub = _pb_decode(chunk, depth + 1, max_depth)
+                    except ValueError:
+                        sub = None
+                text = None
+                try:
+                    text = chunk.decode("utf-8")
+                    if not text.isprintable():
+                        text = None
+                except UnicodeDecodeError:
+                    text = None
+                if text is not None and (sub is None or len(text) < 200):
+                    out.append((field, text))
+                elif sub is not None:
+                    out.append((field, sub))
+                else:
+                    out.append((field, chunk[:32].hex()))
+            else:
+                raise ValueError("wiretype")
+    except IndexError as e:
+        raise ValueError("eof") from e
+    return out
+
+
+def _pb_strings(tree, acc=None):
+    acc = [] if acc is None else acc
+    for _f, v in tree:
+        if isinstance(v, list):
+            _pb_strings(v, acc)
+        elif isinstance(v, str) and len(v) < 120 and not all(c in "0123456789abcdef" for c in v):
+            acc.append(v)
+    return acc
+
+
+def _decode_player_overlay(remote_slots_data: str):
+    """remoteSlotsData -> (Baum, Texte) aus dem base64/URL-codierten playerOverlay."""
+    import base64
+    from urllib.parse import unquote
+
+    slots = json.loads(remote_slots_data or "{}")
+    raw = slots.get("playerOverlay")
+    if not raw:
+        return None, []
+    b64 = unquote(raw)
+    b64 += "=" * (-len(b64) % 4)
+    try:
+        data = base64.urlsafe_b64decode(b64)
+    except Exception:
+        data = base64.b64decode(b64)
+    tree = _pb_decode(data)
+    return tree, _pb_strings(tree)
+
