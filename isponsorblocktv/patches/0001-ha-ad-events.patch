+def _dump_ad_raw(raw: dict, source: str) -> str:
+    """Fork: komplette Werbe-Meldung (inkl. ungekürztem remoteSlotsData) als JSON
+    nach /share schreiben und jedes base64-Feld zusätzlich dekodiert ablegen."""
+    import time
+
+    os.makedirs(_HA_DUMP_DIR, exist_ok=True)
+    out = {"source": source, "zeit": time.strftime("%Y-%m-%d %H:%M:%S"), "raw": raw}
+    try:
+        slots = json.loads(raw.get("remoteSlotsData") or "{}")
+    except Exception as e:
+        slots = {}
+        out["slots_fehler"] = str(e)
+    out["slots"] = slots
+    decoded = {}
+    for key, val in slots.items():
+        if isinstance(val, str) and len(val) > 16:
+            try:
+                tree, texts = _b64_pb(val)
+                decoded[key] = {"texte": texts, "baum": tree}
+            except Exception as e:
+                decoded[key] = {"fehler": str(e)}
+    out["dekodiert"] = decoded
+    name = f"{time.strftime('%Y%m%d-%H%M%S')}_{raw.get('adVideoId') or 'unbekannt'}.json"
+    path = os.path.join(_HA_DUMP_DIR, name)
+    with open(path, "w", encoding="utf-8") as fh:
+        json.dump(out, fh, ensure_ascii=False, indent=1, default=str)
+    return path
+
 
